# Datenbank (Supabase -> Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...

# Garmin Personal API Key
GARMIN_PERSONAL_API_KEY=

# Anmeldung
SESSION_SECRET=              # mindestens 32 zufällige Zeichen: openssl rand -hex 32
APP_ORIGIN=https://dein-projekt.vercel.app
# RP_ID=dein-projekt.vercel.app   # optional, sonst aus APP_ORIGIN
SETUP_TOKEN=                 # nur für den ersten Passkey; danach entfernen oder behalten
CRON_SECRET=                 # Vercel sendet ihn als Bearer-Token an /api/cron/sync

# Lokal ohne Supabase: JSON-Datei statt Datenbank
# LOCAL_DB=./local-db.json
