{
  "version": 2,
  "regions": ["fra1"],
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/api/cron/sync", "schedule": "30 4 * * *" }, { "path": "/api/cron/notify", "schedule": "0 21 * * *" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }, { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
